# Set the real token in Vercel Settings > Environment Variables, never in GitHub.
POSTMARK_SERVER_TOKEN=
# Add all three Production values to activate JetEmail instead of Postmark.
JETEMAIL_SMTP_HOST=
JETEMAIL_SMTP_USERNAME=
JETEMAIL_SMTP_PASSWORD=
# SMTP is the default and reuses the server token as username and password.
# Set to api to switch back to REST without changing credentials.
# POSTMARK_TRANSPORT=api
# Optional: comma-separated additional exact HTTPS website origins.
# CONTACT_ALLOWED_ORIGINS=https://zaptech.com.au,https://www.zaptech.com.au
